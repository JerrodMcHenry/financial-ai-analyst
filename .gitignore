# Secrets and local configuration
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local data and caches (EDGAR downloads, models). Everything under data/ stays ignored except
# the 16 pinned SEC files the demo and tests read (manifest: evals/sec_snapshots_v1.json).
# Git cannot re-include a file inside an ignored directory, so directories are re-included
# first and every file is listed explicitly; any new file in data/ remains ignored.
data/*
!/data/sec-cache/
/data/sec-cache/**
!/data/sec-cache/**/
!/data/sec-cache/snapshots/company_tickers/all/391effc6a807ae1752c9d2c351dbecab8f15aa1c59b035a9a28f7955a94feb0f.json
