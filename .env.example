# Copy to .env and fill in. Never commit .env.
#
# Nothing here is needed for the offline demonstration, the tests or the scripted evaluations:
# they read the pinned SEC data committed under data/sec-cache and send no requests.

# SEC access: needed only to download from SEC (snapshot acquisition, filing downloads) and to
# start the health-check service. SEC asks automated clients to identify themselves with a
# name and contact email.
# SEC_USER_AGENT="Your Name your.email@example.com"

# Optional. SEC's limit is 10 req/s; values above 10 are rejected.
# SEC_MAX_REQUESTS_PER_SECOND=4

# Optional. Where downloaded filing documents are cached.
# FILING_CACHE_DIR=data/sec-cache

# Live LLM provider: needed only for the Streamlit app and `python -m financial_analyst.live_agent`.
# Any OpenAI-compatible /chat/completions endpoint. Never commit a real key.
# Set either key name; LLM_API_KEY wins when both are set.
# OPENAI_API_KEY="your-provider-api-key"
# LLM_API_KEY="your-provider-api-key"
# LLM_MODEL="your-model-id"
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_REQUEST_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE=0
# Prices in USD per million tokens, used only to estimate cost in reports.
# LLM_INPUT_COST_PER_MTOK=
# LLM_OUTPUT_COST_PER_MTOK=
