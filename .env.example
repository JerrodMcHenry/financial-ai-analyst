# Copy to .env and fill in. Never commit .env.

# Required. SEC asks automated clients to identify themselves with a name and contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional. SEC's limit is 10 req/s; values above 10 are rejected.
# SEC_MAX_REQUESTS_PER_SECOND=4

# Optional. Where downloaded filing documents are cached (git-ignored by default).
# FILING_CACHE_DIR=data/sec-cache
